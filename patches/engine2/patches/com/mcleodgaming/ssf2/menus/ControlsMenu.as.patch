+      private function onGamepadButtonDown(param1:GamepadEvent) : void
+      {
+         var enabled:Boolean = false;
+         var state:Object = param1.controlState;
+         if(Boolean(state) && Boolean(state.inputs) && state.inputs.indexOf("TAUNT") >= 0)
+         {
