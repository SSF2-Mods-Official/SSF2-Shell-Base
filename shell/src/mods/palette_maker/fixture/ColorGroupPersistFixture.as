package
{
	import com.sbxmod.paletteMaker.ColorGroupPersist;
	import flash.desktop.NativeApplication;
	import flash.display.Sprite;
	import flash.events.Event;
	import flash.filesystem.File;
	import flash.filesystem.FileMode;
	import flash.filesystem.FileStream;

	/**
	 * Color groups keep membership across loads; swatch / layer paint must not
	 * survive restore or serialize, so enable cannot re-bake another costume.
	 */
	public class ColorGroupPersistFixture extends Sprite
	{
		public function ColorGroupPersistFixture()
		{
			addEventListener(Event.ADDED_TO_STAGE, onStage);
		}

		private function onStage(e:Event):void
		{
			var failure:String;
			removeEventListener(Event.ADDED_TO_STAGE, onStage);
			try
			{
				failure = check();
			}
			catch (err:*)
			{
				failure = "threw " + err;
			};
			trace(failure ? ("FIXTURE FAIL " + failure) : "FIXTURE OK");
			try
			{
				writeResult(failure);
			}
			catch (writeErr:*)
			{
				trace("FIXTURE write " + writeErr);
			};
			NativeApplication.nativeApplication.exit(failure ? 1 : 0);
		}

		private function check():String
		{
			var live:Object;
			var saved:Object;
			var dirtyEntry:Object;
			var restored:Object;
			var got:Array;
			live = {
				"groupName": "Group A",
				"memberColors": [0xFF112233, 0xFF445566],
				"primaryColor": 0xFF112233,
				"locked": false,
				"groupEnabled": true,
				"autoGenerated": false,
				"userModified": true,
				"formName": "mario",
				"matchAllMode": true,
				"useSwatch": true,
				"hasSwatchColor": true,
				"swatchColor": 0xFFFF0000,
				"swatchRelativePrimary": 0xFF00FF00,
				"layerReplacements": { "4279378479": 0xFFFFFFFF },
				"preSwatchReplacements": { "4279378479": 0xFF000000 }
			};
			if (!ColorGroupPersist.wouldReapplySwatch(live))
			{
				return "live dirty group should reapply swatch";
			};
			saved = ColorGroupPersist.serializeMembership(live);
			if (!saved)
			{
				return "serialize null";
			};
			if (saved.hasOwnProperty("useSwatch") || saved.hasOwnProperty("hasSwatchColor")
				|| saved.hasOwnProperty("swatchColor") || saved.hasOwnProperty("layerReplacements")
				|| saved.hasOwnProperty("swatchRelativePrimary"))
			{
				return "serialize leaked paint fields";
			};
			if (!(saved.memberColors is Array) || saved.memberColors.length != 2)
			{
				return "serialize members";
			};
			if (saved.matchAllMode != true || saved.groupName != "Group A")
			{
				return "serialize membership flags";
			};
			dirtyEntry = {
				"groupName": "Group B",
				"memberColors": [0xFFAAAAAA],
				"primaryColor": 0xFFAAAAAA,
				"enabled": true,
				"matchAllMode": true,
				"useSwatch": true,
				"hasSwatchColor": true,
				"swatchColor": 0xFF00FFFF,
				"layerReplacements": { "1": 2 }
			};
			restored = {
				"memberColors": [],
				"groupName": "",
				"primaryColor": 0,
				"groupEnabled": false,
				"matchAllMode": false,
				"useSwatch": true,
				"hasSwatchColor": true,
				"swatchColor": 0xFFFFFFFF,
				"layerReplacements": { "9": 9 }
			};
			ColorGroupPersist.applyMembershipOnly(restored, dirtyEntry);
			if (ColorGroupPersist.wouldReapplySwatch(restored))
			{
				return "restored group still reapplies swatch";
			};
			if (restored.hasSwatchColor || restored.useSwatch || restored.layerReplacements != null)
			{
				return "restored paint not cleared";
			};
			if (!(restored.memberColors is Array) || restored.memberColors.length != 1
				|| uint(restored.memberColors[0]) != 0xFFAAAAAA)
			{
				return "restored members";
			};
			if (restored.matchAllMode != true || restored.groupName != "Group B")
			{
				return "restored membership";
			};
			ColorGroupPersist.clearSessionPaint(live);
			if (ColorGroupPersist.wouldReapplySwatch(live))
			{
				return "clearSessionPaint left swatch path live";
			};
			got = ColorGroupPersist.membersForRestore([0xFF111111, 0xFF222222], []);
			if (!got || got.length != 2 || uint(got[0]) != 0xFF111111)
			{
				return "membersForRestore should keep saved when none resolve";
			};
			got = ColorGroupPersist.membersForRestore([0xFF111111], [0xFFAAAAAA]);
			if (!got || got.length != 1 || uint(got[0]) != 0xFFAAAAAA)
			{
				return "membersForRestore prefers resolved";
			};
			return "";
		}

		private function writeResult(failure:String):void
		{
			var file:File = File.applicationStorageDirectory.resolvePath("color-group-persist-fixture.txt");
			var stream:FileStream = new FileStream();
			stream.open(file, FileMode.WRITE);
			stream.writeUTFBytes(failure ? ("FAIL " + failure) : "OK");
			stream.close();
		}
	}
}
