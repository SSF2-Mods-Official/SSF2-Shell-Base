package com.sbxmod.paletteMaker
{
	import flash.display.Sprite;
	import flash.display.Stage;
	import flash.events.MouseEvent;
	import flash.text.TextField;
	import flash.text.TextFormat;
	import flash.text.TextFieldAutoSize;

	public class PaletteGroupSquare extends Sprite
	{
		public var memberColors:Array;
		public var primaryColor:uint = 0;
		public var useSwatch:Boolean = false;
		public var matchAllMode:Boolean = false;
		public var swatchColor:uint = 0;
		public var hasSwatchColor:Boolean = false;
		/** Primary replacement at the moment swatch was picked; used for shade transfer on new members. */
		public var swatchRelativePrimary:uint = 0;
		/** baseColor -> replacement before any swatch edits; used to fully undo swatch. */
		public var preSwatchReplacements:Object = null;
		/** Per-group intended replacements for layering (owner wins on reorder). */
		public var layerReplacements:Object = null;
		public var groupName:String = "Group";
		/** When true, membership cannot be changed via swatch select/deselect. */
		public var locked:Boolean = false;
		/** True when created by shade auto-gen (vs manual CG / restore without flag). */
		public var autoGenerated:Boolean = false;
		/** True after rename / member add/remove — untouched auto groups can be purged. */
		public var userModified:Boolean = false;
		/** When false, group is ignored for ownership / priority walks. */
		public var groupEnabled:Boolean = true;
		/** RE mode FX chip: costume fxGroups[].id (null for body color groups). */
		public var pmFxGroupId:String = null;
		/** Zelda, Sheik, Bowser, or Giga Bowser. Empty means the form the editor opened. */
		public var formName:String = "";

		private var m_boxSize:Number;
		private var m_onActivate:Function;
		private var m_onDragReorder:Function;
		private var m_onDragEnd:Function;
		private var m_isSelected:Boolean = false;
		private var borderSprite:Sprite;
		private var unchangedHighlight:Sprite;
		private var triangle:Sprite;
		private var nameLabel:TextField;
		private var cornerRadius:Number = 5;
		private var m_unchangedHighlight:Boolean = false;
		private var dragArmed:Boolean = false;
		private var dragMoved:Boolean = false;
		private var dragStartX:Number = 0;

		public function PaletteGroupSquare(memberColors:Array, boxSize:Number, onActivate:Function, groupName:String = "Group", onDragReorder:Function = null, onDragEnd:Function = null)
		{
			this.memberColors = memberColors ? memberColors.concat() : [];
			this.groupName = groupName && groupName.length > 0 ? groupName : "Group";
			m_boxSize = boxSize;
			m_onActivate = onActivate;
			m_onDragReorder = onDragReorder;
			m_onDragEnd = onDragEnd;
			borderSprite = new Sprite();
			unchangedHighlight = new Sprite();
			unchangedHighlight.mouseEnabled = false;
			triangle = new Sprite();
			nameLabel = new TextField();
			nameLabel.defaultTextFormat = new TextFormat("_sans", 7, 0xFFFFFF, true, null, null, null, null, "center");
			nameLabel.autoSize = TextFieldAutoSize.CENTER;
			nameLabel.mouseEnabled = false;
			nameLabel.selectable = false;
			nameLabel.text = shortName();
			nameLabel.x = (boxSize - nameLabel.width) * 0.5;
			nameLabel.y = 0;
			addChild(triangle);
			addChild(borderSprite);
			addChild(unchangedHighlight);
			addChild(nameLabel);
			buttonMode = true;
			useHandCursor = true;
			addEventListener(MouseEvent.MOUSE_DOWN, handleMouseDown);
			redrawFace(0x888888, 0x888888);
			applyEnabledVisual();
		}

		public function getShortName():String
		{
			return shortName();
		}

		private function shortName():String
		{
			var parts:Array;
			var word:String;
			var a:String;
			var b:String;
			var i:int;
			var last:String;
			if (!groupName)
			{
				return "G?";
			};
			parts = groupName.split(" ");
			i = parts.length - 1;
			while (i >= 0)
			{
				if (!parts[i] || String(parts[i]).length == 0)
				{
					parts.splice(i, 1);
				};
				i--;
			};
			// Auto-gen suffix "AUTO": badge shows letter + A (e.g. "A AUTO" → "AA", "B AUTO" → "BA").
			// Legacy "AG" suffix kept for already-named groups until schema wipe.
			if (parts.length >= 2)
			{
				last = String(parts[parts.length - 1]).toUpperCase();
				if (last == "AUTO" || last == "AG")
				{
					word = String(parts[parts.length - 2]);
					a = word.length > 0 ? word.charAt(0) : "A";
					b = last == "AUTO" ? "A" : "G";
					return (a + b).toUpperCase();
				};
				a = String(parts[0]).charAt(0);
				b = String(parts[1]).charAt(0);
				return (a + b).toUpperCase();
			};
			word = String(parts.length > 0 ? parts[0] : groupName);
			if (word.length >= 2)
			{
				return word.substr(0, 2).toUpperCase();
			};
			if (word.length == 1)
			{
				return (word + word).toUpperCase();
			};
			return "G?";
		}

		public function setGroupName(value:String):void
		{
			var next:String = value && value.length > 0 ? value : "Group";
			if (groupName != next)
			{
				userModified = true;
			};
			groupName = next;
			if (nameLabel)
			{
				nameLabel.text = shortName();
				nameLabel.x = (m_boxSize - nameLabel.width) * 0.5;
			};
		}

		public function setGroupEnabled(value:Boolean):void
		{
			groupEnabled = value;
			applyEnabledVisual();
		}

		private function applyEnabledVisual():void
		{
			alpha = groupEnabled ? 1 : 0.4;
		}

		private function handleMouseDown(e:MouseEvent):void
		{
			var st:Stage;
			e.stopPropagation();
			if (ColorSquare.canInteract != null && !ColorSquare.canInteract())
			{
				return;
			};
			dragArmed = true;
			dragMoved = false;
			dragStartX = e.stageX;
			st = stage;
			if (st)
			{
				st.addEventListener(MouseEvent.MOUSE_MOVE, handleStageMouseMove, false, 0, true);
				st.addEventListener(MouseEvent.MOUSE_UP, handleStageMouseUp, false, 0, true);
			};
		}

		private function handleStageMouseMove(e:MouseEvent):void
		{
			if (!dragArmed)
			{
				return;
			};
			if (!dragMoved && Math.abs(e.stageX - dragStartX) >= 5)
			{
				dragMoved = true;
			};
			if (dragMoved && m_onDragReorder != null)
			{
				m_onDragReorder(this, e.stageX);
			};
		}

		private function handleStageMouseUp(e:MouseEvent):void
		{
			var st:Stage = stage;
			if (st)
			{
				st.removeEventListener(MouseEvent.MOUSE_MOVE, handleStageMouseMove);
				st.removeEventListener(MouseEvent.MOUSE_UP, handleStageMouseUp);
			};
			if (!dragArmed)
			{
				return;
			};
			dragArmed = false;
			if (dragMoved)
			{
				if (m_onDragEnd != null)
				{
					m_onDragEnd(this);
				};
			}
			else if (m_onActivate != null)
			{
				m_onActivate(this);
			};
			dragMoved = false;
		}

		public function killEvents():void
		{
			var st:Stage = stage;
			removeEventListener(MouseEvent.MOUSE_DOWN, handleMouseDown);
			if (st)
			{
				st.removeEventListener(MouseEvent.MOUSE_MOVE, handleStageMouseMove);
				st.removeEventListener(MouseEvent.MOUSE_UP, handleStageMouseUp);
			};
		}

		public function get isSelected():Boolean
		{
			return m_isSelected;
		}

		public function setSelected(value:Boolean):void
		{
			m_isSelected = value;
			borderSprite.graphics.clear();
			if (m_isSelected)
			{
				borderSprite.graphics.lineStyle(1.5, 0xFFFFFF, 0.9);
				borderSprite.graphics.drawRoundRect(0, 0, m_boxSize, m_boxSize, cornerRadius, cornerRadius);
			};
			refreshHighlightLayerOrder();
		}

		public function setUnchangedHighlight(on:Boolean):void
		{
			if (m_unchangedHighlight == on)
			{
				return;
			};
			m_unchangedHighlight = on;
			if (!unchangedHighlight)
			{
				return;
			};
			unchangedHighlight.graphics.clear();
			if (m_unchangedHighlight)
			{
				unchangedHighlight.graphics.lineStyle(1, 0xFFDD00, 1);
				unchangedHighlight.graphics.drawRoundRect(-0.5, -0.5, m_boxSize + 1, m_boxSize + 1, cornerRadius, cornerRadius);
			};
			refreshHighlightLayerOrder();
		}

		private function refreshHighlightLayerOrder():void
		{
			if (unchangedHighlight)
			{
				setChildIndex(unchangedHighlight, numChildren - 1);
			};
			if (borderSprite)
			{
				setChildIndex(borderSprite, numChildren - 1);
			};
			if (nameLabel)
			{
				setChildIndex(nameLabel, numChildren - 1);
			};
		}

		public function removeMember(color:uint):Boolean
		{
			var i:int = 0;
			var removed:Boolean = false;
			// Strip every same-RGB sibling — colorsMatch treats alpha variants as one
			// family, so leaving one behind keeps hasMember() true and blocks exclusivity.
			while (i < memberColors.length)
			{
				if (PaletteColorAnalysis.colorsMatch(uint(memberColors[i]), color))
				{
					memberColors.splice(i, 1);
					removed = true;
					userModified = true;
					continue;
				};
				i++;
			};
			return removed;
		}

		public function addMember(color:uint):Boolean
		{
			if (hasMember(color))
			{
				return false;
			};
			memberColors.push(color);
			userModified = true;
			return true;
		}

		public function hasMember(color:uint):Boolean
		{
			var i:int = 0;
			while (i < memberColors.length)
			{
				if (PaletteColorAnalysis.colorsMatch(uint(memberColors[i]), color))
				{
					return true;
				};
				i++;
			};
			return false;
		}

		public function clearSwatchState():void
		{
			useSwatch = false;
			matchAllMode = false;
			hasSwatchColor = false;
			swatchRelativePrimary = 0;
			preSwatchReplacements = null;
		}

		public function redrawFace(originalColor:uint, replacementColor:uint):void
		{
			graphics.clear();
			graphics.beginFill(originalColor & 0x00FFFFFF, 1);
			graphics.drawRoundRect(0, 0, m_boxSize, m_boxSize, cornerRadius, cornerRadius);
			graphics.endFill();
			triangle.graphics.clear();
			triangle.graphics.beginFill(replacementColor & 0x00FFFFFF, 1);
			triangle.graphics.drawRoundRect(0, m_boxSize * 0.5, m_boxSize, m_boxSize * 0.5, cornerRadius, cornerRadius);
			triangle.graphics.endFill();
			if (nameLabel)
			{
				setChildIndex(nameLabel, numChildren - 1);
			};
			applyEnabledVisual();
		}
	}
}
