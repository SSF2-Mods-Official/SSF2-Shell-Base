package com.sbxmod.paletteMaker
{
	/**
	 * Color groups persist membership and flags across costumes.
	 * Swatch paint and layer replacements are session-only so a load keeps that costume's palette.
	 */
	public class ColorGroupPersist
	{
		/** True when reapplyOwnerLayerPalette would paint from a stored swatch. */
		public static function wouldReapplySwatch(group:Object):Boolean
		{
			if (!group)
			{
				return false;
			};
			return group.hasSwatchColor == true
				&& (group.useSwatch == true || group.matchAllMode == true);
		}

		/** SharedObject / export payload: membership only, no paint. */
		public static function serializeMembership(group:Object):Object
		{
			var members:Array;
			var color:uint;
			var i:int;
			var list:*;
			if (!group)
			{
				return null;
			};
			members = [];
			list = group.memberColors;
			i = 0;
			while (list && i < list.length)
			{
				color = uint(list[i]);
				if (members.indexOf(color) == -1)
				{
					members.push(color);
				};
				i++;
			};
			return {
				"groupName": group.groupName ? String(group.groupName) : "Group",
				"memberColors": members,
				"primaryColor": uint(group.primaryColor),
				"locked": group.locked == true,
				"enabled": group.groupEnabled != false,
				"autoGenerated": group.autoGenerated == true,
				"userModified": group.userModified == true,
				"formName": group.formName ? String(group.formName) : "",
				"matchAllMode": group.matchAllMode == true
			};
		}

		/** Apply a saved entry onto a live group without restoring swatch or layer paint. */
		public static function applyMembershipOnly(group:Object, entry:Object):void
		{
			var members:Array;
			var color:uint;
			var i:int;
			var filtered:Array;
			if (!group || !entry)
			{
				return;
			};
			members = (entry.memberColors is Array) ? (entry.memberColors as Array) : [];
			filtered = [];
			i = 0;
			while (i < members.length)
			{
				color = uint(members[i]);
				if (filtered.indexOf(color) == -1)
				{
					filtered.push(color);
				};
				i++;
			};
			group.memberColors = filtered;
			group.groupName = entry.groupName ? String(entry.groupName) : "Group";
			group.primaryColor = entry.hasOwnProperty("primaryColor") ? uint(entry.primaryColor) : (filtered.length > 0 ? uint(filtered[0]) : 0);
			if (filtered.length > 0 && filtered.indexOf(uint(group.primaryColor)) == -1)
			{
				group.primaryColor = uint(filtered[0]);
			};
			group.locked = entry.locked == true;
			group.autoGenerated = entry.autoGenerated == true;
			group.userModified = entry.userModified == true;
			group.formName = entry.formName ? String(entry.formName) : "";
			group.matchAllMode = entry.matchAllMode == true;
			group.groupEnabled = entry.hasOwnProperty("enabled") ? entry.enabled != false : true;
			try
			{
				group.setGroupEnabled(group.groupEnabled);
			}
			catch (enErr:*)
			{
			};
			clearSessionPaint(group);
		}

		/** Drop swatch + layer paint so enable/reorder cannot re-bake an old costume. */
		public static function clearSessionPaint(group:Object):void
		{
			if (!group)
			{
				return;
			};
			group.useSwatch = false;
			group.hasSwatchColor = false;
			group.swatchColor = 0;
			group.swatchRelativePrimary = 0;
			group.layerReplacements = null;
			group.preSwatchReplacements = null;
		}

		/**
		 * Members to keep when restoring a group. If the current palette resolves none
		 * of the saved colors, keep the saved list so a locker recolor cannot delete the group.
		 */
		public static function membersForRestore(savedMembers:Array, resolvedMembers:Array):Array
		{
			var out:Array;
			var i:int;
			var color:uint;
			if (resolvedMembers && resolvedMembers.length > 0)
			{
				return resolvedMembers;
			};
			out = [];
			i = 0;
			while (savedMembers && i < savedMembers.length)
			{
				color = uint(savedMembers[i]);
				if (out.indexOf(color) == -1)
				{
					out.push(color);
				};
				i++;
			};
			return out;
		}
	}
}
